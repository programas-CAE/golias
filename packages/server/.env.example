# Banco de dados (Postgres). Em desenvolvimento local (server rodando fora
# de container, via "pnpm dev"), use "localhost". Ao rodar via
# "docker compose up -d --build" (produção/VPS), o host deve ser "db" (nome
# do serviço na rede interna do Compose), não "localhost".
DATABASE_URL="postgresql://golias:golias@localhost:5432/golias?schema=public"

# Porta HTTP da API Fastify.
PORT=3333

# Segredos usados para assinar tokens JWT de acesso e de refresh.
# Gere valores fortes e únicos por ambiente, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# SMTP usado para o envio de e-mails de aprovação de RDO ao fiscal.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Diretório raiz onde os anexos de RDO (fotos, notas fiscais, PDFs) são
# armazenados no disco do servidor.
UPLOADS_ROOT="./uploads"

# URLs públicas usadas na geração de links (e-mails de aprovação, captura em
# campo) e em respostas de CORS.
PUBLIC_WEB_URL="http://localhost:5173"
PUBLIC_API_URL="http://localhost:3333"
