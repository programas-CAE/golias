{
  "name": "@golias/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "files": [
    "src",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.seed.json && tsc --noEmit -p tsconfig.test.json",
    "prisma:generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@golias/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "nodemailer": "^9.1.1",
    "pdf-parse": "1.1.1",
    "pdfkit": "^0.20.1",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
