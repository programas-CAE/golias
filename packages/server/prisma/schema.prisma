datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum FrenteCodigo {
  MAB
  PBA
  RAMAL
}

enum RdoStatus {
  RASCUNHO
  EM_CORRECAO
  // Encarregado assinou no celular — antes de ir pro fiscal, o RDO passa
  // pelo escritório pra revisão/correção. Só depois que o escritório
  // aciona "enviar pro fiscal" é que o status muda pra
  // AGUARDANDO_APROVACAO e o RDO aparece no portal do fiscal.
  AGUARDANDO_VALIDACAO_ESCRITORIO
  AGUARDANDO_APROVACAO
  APROVADO
  REPROVADO
}

// Declarado pelo encarregado por atividade vinculada a uma OM — se aquele
// trabalho terminou naquele dia ou continua em outro RDO futuro. Distinto
// do status derivado no Farol de OM (que olha o RDO aprovado/reprovado):
// uma OM pode ter RDO aprovado e ainda assim estar "em andamento" (só uma
// parte do serviço foi feita naquele dia).
enum StatusOmDeclarado {
  EM_ANDAMENTO
  CONCLUIDA
}

enum UnidadeMedida {
  M
  M2
  M3
  UND
  HH
  M3KM
}

enum TempoClima {
  SOL
  CHUVA
  NUBLADO
}

enum TipoAnexo {
  FOTO
  NOTA_FISCAL
  DOCUMENTO
}

enum AprovacaoStatus {
  PENDENTE
  APROVADO
  REPROVADO
  EXPIRADO
}

enum UsuarioRole {
  ADMIN
  ESCRITORIO
  FISCAL
  ENCARREGADO
}

enum PeriodoMedicaoStatus {
  ABERTO
  FECHADO
}

model AtividadeCatalogo {
  id            String         @id @default(cuid())
  codigo        String
  descricao     String
  unidade       UnidadeMedida
  metaPus       Decimal?       @db.Decimal(10, 4)
  usaDimensoes  Boolean        @default(false)
  ativo         Boolean        @default(true)
  ordem         Int            @default(0)
  rdoAtividades RdoAtividade[]
}

model FuncaoCatalogo {
  id                 String                  @id @default(cuid())
  nome               String                  @unique
  ativo              Boolean                 @default(true)
  colaboradores      Colaborador[]
  equipeMembros      EquipeMembro[]
  maoDeObra          RdoMaoDeObra[]
  atividadeMaoDeObra RdoAtividadeMaoDeObra[]
}

model EquipamentoCatalogo {
  id              String           @id @default(cuid())
  nome            String           @unique
  ativo           Boolean          @default(true)
  rdoEquipamentos RdoEquipamento[]
}

// Contrato vigente (ex.: SAP 5900130281). Frentes e o catálogo de materiais
// (preços da price list) são vinculados a um contrato — trocar o contrato
// de uma frente, ou cadastrar um novo, troca os dados dependentes (preços,
// número impresso no RDO) sem precisar editar cada registro um por um.
model Contrato {
  id        String             @id @default(cuid())
  numero    String             @unique
  nome      String?
  ativo     Boolean            @default(true)
  frentes   Frente[]
  materiais MaterialCatalogo[]
}

model Frente {
  id                     String            @id @default(cuid())
  codigo                 FrenteCodigo      @unique
  nome                   String
  contratoId             String
  contrato               Contrato          @relation(fields: [contratoId], references: [id])
  ativo                  Boolean           @default(true)
  // Meta de eficiência (%) usada como referência no gauge "PUS por frente"
  // da tela de início — ver packages/shared/src/constants/catalogo.ts.
  metaEficienciaPct      Decimal?          @db.Decimal(5, 2)
  // Meta de PUS geral da equipe (não por atividade) — só exibida como
  // referência, sem um "PUS geral" calculado para comparar.
  metaPusGeral           Decimal?          @db.Decimal(6, 2)
  // Link fixo (sem expirar) do portal do fiscal dessa frente — gerado sob
  // demanda pela tela Frentes do escritório. Diferente de um token por RDO:
  // o fiscal salva/favorita esse link e vê todos os RDOs da frente nele.
  portalFiscalToken      String?           @unique
  // Link fixo (sem expirar) do portal do encarregado dessa frente — mesma
  // lógica do portalFiscalToken, mas pro encarregado montar a equipe do dia
  // e abrir o RDO de hoje sem precisar que o escritório crie um RDO e mande
  // o link de campo antes.
  portalEncarregadoToken String?           @unique
  distritos              Distrito[]
  ordensManutencao       OrdemManutencao[]
  rdos                   Rdo[]
  usuarios               Usuario[]
}

// Subdivisão geográfica de uma Frente (ex.: Marabá, Bom Jesus das Selvas).
// Cada Equipe pertence a um Distrito, não direto à Frente — a frente de uma
// equipe é alcançada via distrito.frente.
model Distrito {
  id       String   @id @default(cuid())
  nome     String
  frenteId String
  frente   Frente   @relation(fields: [frenteId], references: [id])
  ativo    Boolean  @default(true)
  equipes  Equipe[]

  @@unique([frenteId, nome])
}

model Colaborador {
  id            String         @id @default(cuid())
  matricula     String         @unique
  nome          String
  funcaoId      String
  funcao        FuncaoCatalogo @relation(fields: [funcaoId], references: [id])
  ativo         Boolean        @default(true)
  equipeMembros EquipeMembro[]
  rdoMaoDeObra  RdoMaoDeObra[]
  usuarioLogin  Usuario?
}

model Equipe {
  id            String         @id @default(cuid())
  nome          String
  distritoId    String
  distrito      Distrito       @relation(fields: [distritoId], references: [id])
  encarregadoId String?
  ativo         Boolean        @default(true)
  membros       EquipeMembro[]
  rdos          Rdo[]
}

// Efetivo da equipe — desde que o usuário pediu pra não precisar nomear
// pessoa (só função + quantidade, ex.: "3 Pedreiro"), colaboradorId é
// opcional: quando ausente, a linha representa um posto genérico daquela
// função; quando presente, mantém a pessoa nomeada (uso já existente, ex.:
// encarregado listado como membro). Postgres permite múltiplos NULL sob um
// unique index, então dá pra ter várias linhas "só função" na mesma equipe.
model EquipeMembro {
  id            String         @id @default(cuid())
  equipeId      String
  equipe        Equipe         @relation(fields: [equipeId], references: [id])
  colaboradorId String?
  colaborador   Colaborador?   @relation(fields: [colaboradorId], references: [id])
  funcaoId      String
  funcao        FuncaoCatalogo @relation(fields: [funcaoId], references: [id])
  quantidade    Int            @default(1)

  @@unique([equipeId, colaboradorId])
}

model OrdemManutencao {
  id                   String                @id @default(cuid())
  numero               String                @unique
  frenteId             String
  frente               Frente                @relation(fields: [frenteId], references: [id])
  dataEmissao          DateTime
  kmInicial            Decimal?              @db.Decimal(10, 3)
  kmFinal              Decimal?              @db.Decimal(10, 3)
  lado                 String?
  detalhes             String?
  atividades           RdoAtividade[]
  anexos               RdoAnexo[]
  relatorioFotografico RelatorioFotografico?
}

// Checklist de Conclusão de Manutenção Preventiva/Corretiva - Infraestrutura
// (documento oficial da Vale/EFC — "Relatório Fotográfico"). Um por OM.
// Criado (e pré-preenchido com as fotos que o encarregado já lançou pra
// essa OM) na primeira vez que a tela é aberta no escritório; depois disso
// é só ajuste — sincronizar novas fotos é uma ação separada, pra não
// ressuscitar uma foto que o escritório removeu de propósito.
model RelatorioFotografico {
  id                   String                     @id @default(cuid())
  ordemManutencaoId    String                     @unique
  ordemManutencao      OrdemManutencao            @relation(fields: [ordemManutencaoId], references: [id])
  dataConclusao        DateTime?                  @db.Date
  // "* Todas as atividades listadas na OM foram executadas;" — único item
  // do checklist original, com a caixa "OK".
  atividadesExecutadas Boolean                    @default(true)
  comentarios          String?
  pdfPath              String?
  fotos                RelatorioFotograficoFoto[]
  criadoEm             DateTime                   @default(now())
  atualizadoEm         DateTime                   @updatedAt
}

model RelatorioFotograficoFoto {
  id                     String               @id @default(cuid())
  relatorioFotograficoId String
  relatorioFotografico   RelatorioFotografico @relation(fields: [relatorioFotograficoId], references: [id])
  ordem                  Int
  legenda                String?
  // "Remover" é exclusão lógica, não apaga a linha — se apagasse, sincronizar
  // fotos novas do campo ressuscitaria uma foto que o escritório tirou de
  // propósito (o rdoAnexoId voltaria a parecer "nunca visto"). A linha
  // inativa continua existindo só como "já vi essa e tirei".
  ativa                  Boolean              @default(true)
  // Ou referencia uma foto que o encarregado já mandou num RDO (reaproveita
  // o arquivo, sem duplicar), ou foi anexada direto nesta tela pelo
  // escritório (dono do próprio arquivo) — sempre um dos dois, nunca os dois.
  rdoAnexoId             String?
  rdoAnexo               RdoAnexo?            @relation(fields: [rdoAnexoId], references: [id], onDelete: Cascade)
  caminhoArquivo         String?
  nomeOriginal           String?
  mimeType               String?
  tamanhoBytes           Int?
  criadoEm               DateTime             @default(now())
}

// Login de fiscal/encarregado (substitui os links públicos por frente) e,
// futuramente, do próprio escritório. Fiscal loga com email; encarregado
// loga com a matrícula que já tem em Colaborador (matriculaLogin é uma
// cópia pra buscar direto no login, sem precisar de join) — por isso os
// dois campos são opcionais e únicos (Postgres permite vários NULL sob um
// unique index, mesmo padrão já usado em EquipeMembro).
model Usuario {
  id             String               @id @default(cuid())
  nome           String
  email          String?              @unique
  matriculaLogin String?              @unique
  senhaHash      String
  role           UsuarioRole          @default(ESCRITORIO)
  ativo          Boolean              @default(true)
  // Localidade do fiscal/encarregado — várias pessoas (várias linhas de
  // Usuario) podem repetir a mesma frente, cobrindo "mais de um fiscal por
  // localidade". Null pra ADMIN/ESCRITORIO (não são escopados por frente).
  frenteId       String?
  frente         Frente?              @relation(fields: [frenteId], references: [id])
  // Só preenchido pra role ENCARREGADO — liga o login ao Colaborador já
  // cadastrado (nome, matrícula, função continuam vindo de lá).
  colaboradorId  String?              @unique
  colaborador    Colaborador?         @relation(fields: [colaboradorId], references: [id])
  refreshTokens  SessaoRefreshToken[]
}

model SessaoRefreshToken {
  id         String    @id @default(cuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id])
  tokenHash  String    @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  criadoIp   String?
  criadoEm   DateTime  @default(now())
}

model Rdo {
  id                    String      @id @default(cuid())
  frenteId              String
  frente                Frente      @relation(fields: [frenteId], references: [id])
  equipeId              String
  equipe                Equipe      @relation(fields: [equipeId], references: [id])
  // Projeto/empreendimento que esse RDO pertence, pra acompanhar cronograma
  // e materiais consolidados por obra (ver model Obra) — o encarregado
  // escolhe ao lançar o RDO do dia. Opcional porque nem todo RDO precisa
  // estar amarrado a uma obra específica (e RDOs lançados antes desse
  // recurso existir não têm).
  obraId                String?
  obra                  Obra?       @relation(fields: [obraId], references: [id])
  data                  DateTime    @db.Date
  // Preventiva/Corretiva e Terraplenagem usam a mesma forma hoje (locais/
  // atividades OU produção por equipamento — ver RdoLocal/RdoEquipamento);
  // Superestrutura é um formulário totalmente diferente (ferrovia, sem OM,
  // ver RdoSuperestrutura). Escolhido pelo encarregado ao abrir o RDO do
  // dia.
  tipo                  RdoTipo     @default(PREVENTIVA_CORRETIVA)
  // Código de busca rápida (AAAAMMDD + sequência do dia, ex.: "20260830001")
  // — pelo dia em que o RDO foi lançado no sistema, não pelo dia do campo
  // (`data`), pra bater com o que a pessoa tem na cabeça quando cadastra.
  // Sem default de negócio (código real vem sempre de `comCodigoRastreio`,
  // no server) — o default aqui é só uma rede de segurança pra fixture de
  // teste/seed que cria um Rdo direto sem passar por essa função.
  codigoRastreio        String      @unique @default(dbgenerated("gen_random_uuid()::text"))
  // Intervalo de hora extra do dia (formato HH:mm), quando houver — distinto
  // dos horários de cada bloco de atividade (ver RdoBlocoHorario).
  horaExtraInicio       String?
  horaExtraFim          String?
  clima                 TempoClima?
  encarregadoId         String?
  totalDesvios          Int?
  observacoesContratada String?     @db.Text
  observacoesCliente    String?     @db.Text
  status                RdoStatus   @default(RASCUNHO)

  linkCampoToken    String?   @unique
  linkCampoExpiraEm DateTime?

  corrigidoPorId            String?
  corrigidoEm               DateTime?
  // Nome mantido por compatibilidade: na prática marca quando o
  // encarregado finalizou e assinou no celular — não necessariamente
  // quando o RDO chegou ao fiscal (que só acontece depois que o
  // escritório revisa e aciona `POST /rdos/:id/enviar-fiscal`, ver
  // AGUARDANDO_VALIDACAO_ESCRITORIO no enum RdoStatus).
  enviadoParaFiscalEm       DateTime?
  // Imagem (PNG) da assinatura desenhada pelo encarregado ao finalizar e
  // enviar o RDO para aprovação — sem tabela própria porque é só 1 por RDO
  // (diferente da do fiscal, que fica em AprovacaoFiscal junto do resto do
  // registro de aprovação/reprovação).
  assinaturaEncarregadoPath String?

  pdfPath String?
  pdfHash String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  blocosHorario  RdoBlocoHorario[]
  locais         RdoLocal[]
  maoDeObra      RdoMaoDeObra[]
  equipamentos   RdoEquipamento[]
  materiais      RdoMaterial[]
  anexos         RdoAnexo[]
  aprovacoes     AprovacaoFiscal[]
  historico      RdoHistorico[]
  superestrutura RdoSuperestrutura?

  @@index([frenteId, data])
  @@index([status])
  @@index([obraId])
}

// Projeto/empreendimento com nome próprio (ex.: "Duplicação Km 40-60") que
// agrupa RDOs de uma ou mais equipes ao longo do tempo — usado pra
// acompanhar cronograma (calendário de lançamentos) e consolidar a lista
// de materiais usados, na tela "Obras" do escritório. Diferente de
// Frente/Equipe (estrutura organizacional fixa do contrato): uma Obra é
// específica de um trabalho, cadastrada livremente pelo escritório.
model Obra {
  id       String      @id @default(cuid())
  nome     String
  ativo    Boolean     @default(true)
  criadoEm DateTime    @default(now())
  rdos     Rdo[]
  etapas   ObraEtapa[]
}

// Etapa/fase PLANEJADA da obra (ex.: "Terraplenagem: 01 a 15/09"), cadastrada
// pelo escritório antes de acontecer — o cronograma em si. Diferente dos
// RDOs vinculados à obra (Rdo.obraId), que são o que REALMENTE foi
// executado; a tela de Obras compara as duas coisas lado a lado.
model ObraEtapa {
  id                 String   @id @default(cuid())
  obraId             String
  obra               Obra     @relation(fields: [obraId], references: [id])
  nome               String
  dataInicioPrevista DateTime @db.Date
  dataFimPrevista    DateTime @db.Date

  @@index([obraId])
}

enum RdoTipo {
  PREVENTIVA_CORRETIVA
  TERRAPLENAGEM
  SUPERESTRUTURA
  MOTORISTA_OPERADOR
}

// Dados extras de um RDO tipo SUPERESTRUTURA (manutenção de via férrea —
// dormente, trilho, "Linha"+km, sem Ordem de Manutenção) — baseado no
// formulário em papel próprio dessa equipe, diferente do "Relatório Diário
// de Obra" usado por Preventiva/Corretiva/Terraplenagem. Efetivo e
// equipamentos continuam em RdoMaoDeObra/RdoEquipamento (só catálogo
// novo); materiais (dormente, tirefond...) continuam em RdoMaterial/
// MaterialCatalogo. Um por Rdo.
model RdoSuperestrutura {
  id                        String                         @id @default(cuid())
  rdoId                     String                         @unique
  rdo                       Rdo                            @relation(fields: [rdoId], references: [id])
  intervaloProgramadoInicio String?
  intervaloProgramadoFim    String?
  intervaloRealizadoInicio  String?
  intervaloRealizadoFim     String?
  tempoTotalPerdas          String?
  leiturasTemperatura       RdoSuperestruturaTemperatura[]
  servicos                  RdoSuperestruturaServico[]
}

model RdoSuperestruturaTemperatura {
  id                  String            @id @default(cuid())
  rdoSuperestruturaId String
  rdoSuperestrutura   RdoSuperestrutura @relation(fields: [rdoSuperestruturaId], references: [id])
  hora                String
  temperaturaC        Decimal?          @db.Decimal(5, 2)
  ordem               Int
}

// "Serviços Executados" do papel — Código/Descrição livres (digitados pelo
// encarregado): diferente da Price List de AtividadeCatalogo, não existe
// uma lista fechada de códigos de manutenção de via pronta pra virar
// catálogo.
model RdoSuperestruturaServico {
  id                  String            @id @default(cuid())
  rdoSuperestruturaId String
  rdoSuperestrutura   RdoSuperestrutura @relation(fields: [rdoSuperestruturaId], references: [id])
  codigo              String?
  descricao           String
  unidade             String?
  quantidade          Decimal?          @db.Decimal(12, 3)
  linha               String?
  kmInicial           Decimal?          @db.Decimal(10, 3)
  kmFinal             Decimal?          @db.Decimal(10, 3)
  ordem               Int
}

// Linha do tempo do dia (ex.: 07:00–08:50 deslocamento, 08:50–09:10 montagem
// de área de vivência, 09:10–12:00 execução, 12:00–13:00 almoço...), como
// preenchido linha a linha no RDO em papel — independente de quais blocos
// tiveram produção medida (ver RdoLocal/RdoAtividade para isso).
model RdoBlocoHorario {
  id             String @id @default(cuid())
  rdoId          String
  rdo            Rdo    @relation(fields: [rdoId], references: [id])
  horarioInicial String
  horarioFinal   String
  descricao      String @db.Text
  ordem          Int    @default(0)
}

model RdoLocal {
  id         String         @id @default(cuid())
  rdoId      String
  rdo        Rdo            @relation(fields: [rdoId], references: [id])
  descricao  String
  lado       String?
  ordem      Int            @default(0)
  atividades RdoAtividade[]
}

model RdoAtividade {
  id                  String                  @id @default(cuid())
  rdoLocalId          String
  rdoLocal            RdoLocal                @relation(fields: [rdoLocalId], references: [id])
  atividadeCatalogoId String
  atividadeCatalogo   AtividadeCatalogo       @relation(fields: [atividadeCatalogoId], references: [id])
  // Cada atividade é autorizada por uma OM própria — um mesmo local/trecho
  // pode ter atividades diferentes cobertas por OMs diferentes, por isso a
  // OM (e o km, que vem da OM) ficam aqui, não em RdoLocal.
  ordemManutencaoId   String?
  ordemManutencao     OrdemManutencao?        @relation(fields: [ordemManutencaoId], references: [id])
  // Declarado pelo encarregado quando a atividade tem OM vinculada — ver
  // enum StatusOmDeclarado. Sem sentido sem ordemManutencaoId, mas não
  // reforçado no banco (validado na camada de aplicação).
  statusOm            StatusOmDeclarado?
  // Percentual concluído da OM naquele dia (0-100), do jeito que o
  // encarregado reporta no RDO em papel (ex.: "Status do dia: 85%") — só
  // faz sentido junto de statusOm, mesma regra de não reforçado no banco.
  percentualConcluido Int?
  kmInicial           Decimal?                @db.Decimal(10, 3)
  kmFinal             Decimal?                @db.Decimal(10, 3)
  altura              Decimal?                @db.Decimal(10, 3)
  largura             Decimal?                @db.Decimal(10, 3)
  larguraFinal        Decimal?                @db.Decimal(10, 3)
  comprimento         Decimal?                @db.Decimal(10, 3)
  quantidadeDireta    Decimal?                @db.Decimal(12, 3)
  totalCalculado      Decimal                 @db.Decimal(12, 3)
  // Início/fim (HH:mm) desta atividade especificamente — permite que a
  // equipe se divida em atividades simultâneas com horários diferentes.
  // Quando ambos informados, horasTrabalhadas é derivado deles (fim −
  // início) no servidor, não digitado à parte.
  horarioInicial      String?
  horarioFinal        String?
  // Horas efetivamente dedicadas a ESTA atividade nesse dia, e quantas
  // pessoas trabalharam nela — juntas formam os Homens-Hora usados como
  // denominador do PUS por atividade (PUS = produção ÷ (mão de obra ×
  // horas), fórmula da ENGECOM — ver calcularProdutividade em
  // packages/server/src/routes/indicadores.ts). Ambas opcionais: quando
  // não informadas, o cálculo estima a partir do RDO inteiro (mão de obra
  // = efetivo do RDO; horas = horas do dia divididas entre as atividades).
  horasTrabalhadas    Decimal?                @db.Decimal(6, 3)
  // Total de pessoas nesta atividade — soma de `maoDeObra` (a quebra por
  // função) quando ela existe, mantido como campo próprio porque é o que
  // o cálculo de PUS já lê (packages/server/src/routes/indicadores.ts).
  maoObraDireta       Int?
  maoDeObra           RdoAtividadeMaoDeObra[]
  unidade             UnidadeMedida
  // As dimensões acima (altura/largura/.../totalCalculado) são o "Ponto 1",
  // sempre presente — pontos extras (2, 3...) só existem quando a mesma
  // atividade/OM foi medida em mais de um trecho/ponto no mesmo dia (ex.:
  // "ponto 1 rocei 1x5x20, ponto 2 rocei 2x5x4"). O totalCalculado da
  // atividade soma o Ponto 1 com todos os pontosExtras.
  pontosExtras        RdoAtividadePonto[]
}

// Ponto de medição adicional de uma atividade (ver comentário em
// RdoAtividade.pontosExtras) — mesmas dimensões possíveis que a atividade,
// mas sem OM/km/horário/mão de obra próprios, porque ainda é a mesma
// atividade/OM, só outro trecho medido no mesmo dia.
model RdoAtividadePonto {
  id               String       @id @default(cuid())
  rdoAtividadeId   String
  rdoAtividade     RdoAtividade @relation(fields: [rdoAtividadeId], references: [id])
  ordem            Int          @default(0)
  altura           Decimal?     @db.Decimal(10, 3)
  largura          Decimal?     @db.Decimal(10, 3)
  larguraFinal     Decimal?     @db.Decimal(10, 3)
  comprimento      Decimal?     @db.Decimal(10, 3)
  quantidadeDireta Decimal?     @db.Decimal(12, 3)
  totalCalculado   Decimal      @db.Decimal(12, 3)
}

// Mão de obra por função dedicada a UMA atividade específica (ex.: "1
// Encarregado, 1 TST, 1 Pedreiro, 2 Servente" só para essa atividade) —
// diferente de RdoMaoDeObra, que é o efetivo do RDO inteiro no dia.
model RdoAtividadeMaoDeObra {
  id             String         @id @default(cuid())
  rdoAtividadeId String
  rdoAtividade   RdoAtividade   @relation(fields: [rdoAtividadeId], references: [id])
  funcaoId       String
  funcao         FuncaoCatalogo @relation(fields: [funcaoId], references: [id])
  quantidade     Int            @default(1)
}

model RdoMaoDeObra {
  id                   String         @id @default(cuid())
  rdoId                String
  rdo                  Rdo            @relation(fields: [rdoId], references: [id])
  funcaoId             String
  funcao               FuncaoCatalogo @relation(fields: [funcaoId], references: [id])
  colaboradorId        String?
  colaborador          Colaborador?   @relation(fields: [colaboradorId], references: [id])
  quantidade           Int            @default(1)
  horasImprodutivas    Decimal?       @db.Decimal(6, 2)
  causaImprodutividade String?
}

model RdoEquipamento {
  id                    String              @id @default(cuid())
  rdoId                 String
  rdo                   Rdo                 @relation(fields: [rdoId], references: [id])
  equipamentoCatalogoId String
  equipamentoCatalogo   EquipamentoCatalogo @relation(fields: [equipamentoCatalogoId], references: [id])
  quantidade            Int                 @default(1)
  // Produção do equipamento no dia (equipes de terraplenagem apontam por
  // máquina, ex.: "MNE 104 — Manutenção de Acesso: 800m") — vazios quando o
  // equipamento é só um item de checklist comum, sem produção associada.
  producaoDescricao     String?
  producaoValor         Decimal?            @db.Decimal(12, 3)
  producaoUnidade       String?
  // Horímetro do equipamento (leitura inicial/final do dia) — outra forma
  // de apontar produção de terraplenagem, pra máquinas cujo trabalho se
  // mede em horas de operação (não em carradas/metros). Preenchido junto
  // com producaoValor/producaoUnidade não faz sentido — são alternativas,
  // não campos que se somam; a tela decide qual mostrar por equipamento.
  horimetroInicial      Decimal?            @db.Decimal(10, 2)
  horimetroFinal        Decimal?            @db.Decimal(10, 2)
  // Motorista/operador (RdoTipo.MOTORISTA_OPERADOR) — km rodado/rota e
  // combustível abastecido no dia, outra forma de apontar o uso do
  // equipamento/veículo (ver rdoEquipamentoInputSchema em packages/shared).
  kmInicial             Decimal?            @db.Decimal(10, 1)
  kmFinal               Decimal?            @db.Decimal(10, 1)
  rota                  String?
  combustivelLitros     Decimal?            @db.Decimal(10, 2)
  combustivelPosto      String?
}

// Catálogo oficial de materiais/serviços com preço unitário (Price List do
// contrato — packages/server/prisma/data/materialCatalogo.json). Vinculado
// ao Contrato porque preços mudam de um contrato para o outro.
model MaterialCatalogo {
  id            String        @id @default(cuid())
  contratoId    String
  contrato      Contrato      @relation(fields: [contratoId], references: [id])
  codigo        String
  descricao     String
  unidade       String
  precoUnitario Decimal?      @db.Decimal(14, 4)
  ativo         Boolean       @default(true)
  rdoMateriais  RdoMaterial[]

  @@unique([contratoId, codigo])
}

// Materiais consumidos no dia, escolhidos do catálogo (MaterialCatalogo).
model RdoMaterial {
  id                 String           @id @default(cuid())
  rdoId              String
  rdo                Rdo              @relation(fields: [rdoId], references: [id])
  materialCatalogoId String
  materialCatalogo   MaterialCatalogo @relation(fields: [materialCatalogoId], references: [id])
  quantidade         Decimal          @db.Decimal(12, 3)
  ordem              Int              @default(0)
}

model RdoAnexo {
  id                String                     @id @default(cuid())
  rdoId             String
  rdo               Rdo                        @relation(fields: [rdoId], references: [id])
  tipo              TipoAnexo
  caminhoArquivo    String
  nomeOriginal      String
  mimeType          String
  tamanhoBytes      Int
  descricao         String?
  valor             Decimal?                   @db.Decimal(12, 2)
  // Foto tirada para uma OM específica (o encarregado escolhe a OM ao
  // enviar a foto no lançamento de campo) — null pra fotos gerais do dia,
  // notas fiscais e documentos, que não são de uma OM em particular.
  // Usado pra agrupar as fotos por OM no PDF do RDO, na tela do escritório
  // e como fonte pro Relatório Fotográfico da OM (RelatorioFotografico).
  ordemManutencaoId String?
  ordemManutencao   OrdemManutencao?           @relation(fields: [ordemManutencaoId], references: [id])
  criadoEm          DateTime                   @default(now())
  fotosDeRelatorio  RelatorioFotograficoFoto[]
}

model AprovacaoFiscal {
  id                   String          @id @default(cuid())
  rdoId                String
  rdo                  Rdo             @relation(fields: [rdoId], references: [id])
  fiscalNome           String
  fiscalEmail          String
  token                String          @unique
  tokenExpiraEm        DateTime
  status               AprovacaoStatus @default(PENDENTE)
  assinanteNome        String?
  assinadoEm           DateTime?
  assinadoIp           String?
  documentoHash        String?
  assinaturaImagemPath String?
  comentarioReprovacao String?         @db.Text
  observacao           String?         @db.Text
  criadoEm             DateTime        @default(now())
}

model RdoHistorico {
  id         String     @id @default(cuid())
  rdoId      String
  rdo        Rdo        @relation(fields: [rdoId], references: [id])
  deStatus   RdoStatus?
  paraStatus RdoStatus
  ator       String
  observacao String?    @db.Text
  criadoEm   DateTime   @default(now())
}

model PeriodoMedicao {
  id        String               @id @default(cuid())
  frenteId  String
  ano       Int
  mes       Int
  status    PeriodoMedicaoStatus @default(ABERTO)
  fechadoEm DateTime?
  itens     MedicaoItem[]

  @@unique([frenteId, ano, mes])
}

model MedicaoItem {
  id                  String         @id @default(cuid())
  periodoMedicaoId    String
  periodoMedicao      PeriodoMedicao @relation(fields: [periodoMedicaoId], references: [id])
  atividadeCatalogoId String
  quantidadeTotal     Decimal        @db.Decimal(14, 3)
  unidade             UnidadeMedida

  @@unique([periodoMedicaoId, atividadeCatalogoId])
}
