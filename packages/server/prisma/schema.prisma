datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum FrenteCodigo {
  MAB
  PBA
  RAMAL
}

enum RdoStatus {
  RASCUNHO
  EM_CORRECAO
  AGUARDANDO_APROVACAO
  APROVADO
  REPROVADO
}

enum UnidadeMedida {
  M
  M2
  M3
  UND
  HH
  M3KM
}

enum TempoClima {
  SOL
  CHUVA
  NUBLADO
}

enum TipoAnexo {
  FOTO
  NOTA_FISCAL
  DOCUMENTO
}

enum AprovacaoStatus {
  PENDENTE
  APROVADO
  REPROVADO
  EXPIRADO
}

enum UsuarioRole {
  ADMIN
  ESCRITORIO
}

enum PeriodoMedicaoStatus {
  ABERTO
  FECHADO
}

model AtividadeCatalogo {
  id            String         @id @default(cuid())
  codigo        String
  descricao     String
  unidade       UnidadeMedida
  metaPus       Decimal?       @db.Decimal(10, 4)
  usaDimensoes  Boolean        @default(false)
  ativo         Boolean        @default(true)
  ordem         Int            @default(0)
  rdoAtividades RdoAtividade[]
}

model FuncaoCatalogo {
  id            String         @id @default(cuid())
  nome          String         @unique
  ativo         Boolean        @default(true)
  colaboradores Colaborador[]
  equipeMembros EquipeMembro[]
  maoDeObra     RdoMaoDeObra[]
}

model EquipamentoCatalogo {
  id              String           @id @default(cuid())
  nome            String           @unique
  ativo           Boolean          @default(true)
  rdoEquipamentos RdoEquipamento[]
}

// Contrato vigente (ex.: SAP 5900130281). Frentes e o catálogo de materiais
// (preços da price list) são vinculados a um contrato — trocar o contrato
// de uma frente, ou cadastrar um novo, troca os dados dependentes (preços,
// número impresso no RDO) sem precisar editar cada registro um por um.
model Contrato {
  id        String             @id @default(cuid())
  numero    String             @unique
  nome      String?
  ativo     Boolean            @default(true)
  frentes   Frente[]
  materiais MaterialCatalogo[]
}

model Frente {
  id                String            @id @default(cuid())
  codigo            FrenteCodigo      @unique
  nome              String
  contratoId        String
  contrato          Contrato          @relation(fields: [contratoId], references: [id])
  ativo             Boolean           @default(true)
  // Meta de eficiência (%) usada como referência no gauge "PUS por frente"
  // da tela de início — ver packages/shared/src/constants/catalogo.ts.
  metaEficienciaPct Decimal?          @db.Decimal(5, 2)
  // Meta de PUS geral da equipe (não por atividade) — só exibida como
  // referência, sem um "PUS geral" calculado para comparar.
  metaPusGeral      Decimal?          @db.Decimal(6, 2)
  // Link fixo (sem expirar) do portal do fiscal dessa frente — gerado sob
  // demanda pela tela Frentes do escritório. Diferente de um token por RDO:
  // o fiscal salva/favorita esse link e vê todos os RDOs da frente nele.
  portalFiscalToken String?           @unique
  distritos         Distrito[]
  ordensManutencao  OrdemManutencao[]
  rdos              Rdo[]
}

// Subdivisão geográfica de uma Frente (ex.: Marabá, Bom Jesus das Selvas).
// Cada Equipe pertence a um Distrito, não direto à Frente — a frente de uma
// equipe é alcançada via distrito.frente.
model Distrito {
  id       String   @id @default(cuid())
  nome     String
  frenteId String
  frente   Frente   @relation(fields: [frenteId], references: [id])
  ativo    Boolean  @default(true)
  equipes  Equipe[]

  @@unique([frenteId, nome])
}

model Colaborador {
  id            String         @id @default(cuid())
  matricula     String         @unique
  nome          String
  funcaoId      String
  funcao        FuncaoCatalogo @relation(fields: [funcaoId], references: [id])
  ativo         Boolean        @default(true)
  equipeMembros EquipeMembro[]
  rdoMaoDeObra  RdoMaoDeObra[]
}

model Equipe {
  id            String         @id @default(cuid())
  nome          String
  distritoId    String
  distrito      Distrito       @relation(fields: [distritoId], references: [id])
  encarregadoId String?
  ativo         Boolean        @default(true)
  membros       EquipeMembro[]
  rdos          Rdo[]
}

// Efetivo da equipe — desde que o usuário pediu pra não precisar nomear
// pessoa (só função + quantidade, ex.: "3 Pedreiro"), colaboradorId é
// opcional: quando ausente, a linha representa um posto genérico daquela
// função; quando presente, mantém a pessoa nomeada (uso já existente, ex.:
// encarregado listado como membro). Postgres permite múltiplos NULL sob um
// unique index, então dá pra ter várias linhas "só função" na mesma equipe.
model EquipeMembro {
  id            String         @id @default(cuid())
  equipeId      String
  equipe        Equipe         @relation(fields: [equipeId], references: [id])
  colaboradorId String?
  colaborador   Colaborador?   @relation(fields: [colaboradorId], references: [id])
  funcaoId      String
  funcao        FuncaoCatalogo @relation(fields: [funcaoId], references: [id])
  quantidade    Int            @default(1)

  @@unique([equipeId, colaboradorId])
}

model OrdemManutencao {
  id          String     @id @default(cuid())
  numero      String     @unique
  frenteId    String
  frente      Frente     @relation(fields: [frenteId], references: [id])
  dataEmissao DateTime
  kmInicial   Decimal?   @db.Decimal(10, 3)
  kmFinal     Decimal?   @db.Decimal(10, 3)
  lado        String?
  detalhes    String?
  atividades  RdoAtividade[]
}

model Usuario {
  id            String                @id @default(cuid())
  nome          String
  email         String                @unique
  senhaHash     String
  role          UsuarioRole           @default(ESCRITORIO)
  ativo         Boolean               @default(true)
  refreshTokens SessaoRefreshToken[]
}

model SessaoRefreshToken {
  id         String    @id @default(cuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id])
  tokenHash  String    @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  criadoIp   String?
  criadoEm   DateTime  @default(now())
}

model Rdo {
  id                String           @id @default(cuid())
  frenteId          String
  frente            Frente           @relation(fields: [frenteId], references: [id])
  equipeId          String
  equipe            Equipe           @relation(fields: [equipeId], references: [id])
  data              DateTime         @db.Date
  // Intervalo de hora extra do dia (formato HH:mm), quando houver — distinto
  // dos horários de cada bloco de atividade (ver RdoBlocoHorario).
  horaExtraInicio    String?
  horaExtraFim       String?
  clima             TempoClima?
  encarregadoId     String?
  totalDesvios      Int?
  observacoesContratada String?      @db.Text
  observacoesCliente    String?      @db.Text
  status            RdoStatus        @default(RASCUNHO)

  linkCampoToken    String?          @unique
  linkCampoExpiraEm DateTime?

  corrigidoPorId      String?
  corrigidoEm         DateTime?
  enviadoParaFiscalEm DateTime?
  // Imagem (PNG) da assinatura desenhada pelo encarregado ao finalizar e
  // enviar o RDO para aprovação — sem tabela própria porque é só 1 por RDO
  // (diferente da do fiscal, que fica em AprovacaoFiscal junto do resto do
  // registro de aprovação/reprovação).
  assinaturaEncarregadoPath String?

  pdfPath String?
  pdfHash String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  blocosHorario RdoBlocoHorario[]
  locais       RdoLocal[]
  maoDeObra    RdoMaoDeObra[]
  equipamentos RdoEquipamento[]
  materiais    RdoMaterial[]
  anexos       RdoAnexo[]
  aprovacoes   AprovacaoFiscal[]
  historico    RdoHistorico[]

  @@index([frenteId, data])
  @@index([status])
}

// Linha do tempo do dia (ex.: 07:00–08:50 deslocamento, 08:50–09:10 montagem
// de área de vivência, 09:10–12:00 execução, 12:00–13:00 almoço...), como
// preenchido linha a linha no RDO em papel — independente de quais blocos
// tiveram produção medida (ver RdoLocal/RdoAtividade para isso).
model RdoBlocoHorario {
  id             String @id @default(cuid())
  rdoId          String
  rdo            Rdo    @relation(fields: [rdoId], references: [id])
  horarioInicial String
  horarioFinal   String
  descricao      String @db.Text
  ordem          Int    @default(0)
}

model RdoLocal {
  id                String           @id @default(cuid())
  rdoId             String
  rdo               Rdo              @relation(fields: [rdoId], references: [id])
  descricao         String
  lado              String?
  ordem             Int              @default(0)
  atividades        RdoAtividade[]
}

model RdoAtividade {
  id                  String            @id @default(cuid())
  rdoLocalId          String
  rdoLocal            RdoLocal          @relation(fields: [rdoLocalId], references: [id])
  atividadeCatalogoId String
  atividadeCatalogo   AtividadeCatalogo @relation(fields: [atividadeCatalogoId], references: [id])
  // Cada atividade é autorizada por uma OM própria — um mesmo local/trecho
  // pode ter atividades diferentes cobertas por OMs diferentes, por isso a
  // OM (e o km, que vem da OM) ficam aqui, não em RdoLocal.
  ordemManutencaoId   String?
  ordemManutencao     OrdemManutencao?  @relation(fields: [ordemManutencaoId], references: [id])
  kmInicial           Decimal?          @db.Decimal(10, 3)
  kmFinal             Decimal?          @db.Decimal(10, 3)
  altura              Decimal?          @db.Decimal(10, 3)
  largura             Decimal?          @db.Decimal(10, 3)
  larguraFinal        Decimal?          @db.Decimal(10, 3)
  comprimento         Decimal?          @db.Decimal(10, 3)
  quantidadeDireta    Decimal?          @db.Decimal(12, 3)
  totalCalculado      Decimal           @db.Decimal(12, 3)
  // Horas efetivamente dedicadas a ESTA atividade nesse dia, e quantas
  // pessoas trabalharam nela — juntas formam os Homens-Hora usados como
  // denominador do PUS por atividade (PUS = produção ÷ (mão de obra ×
  // horas), fórmula da ENGECOM — ver calcularProdutividade em
  // packages/server/src/routes/indicadores.ts). Ambas opcionais: quando
  // não informadas, o cálculo estima a partir do RDO inteiro (mão de obra
  // = efetivo do RDO; horas = horas do dia divididas entre as atividades).
  horasTrabalhadas    Decimal?          @db.Decimal(6, 3)
  maoObraDireta       Int?
  unidade             UnidadeMedida
}

model RdoMaoDeObra {
  id                   String          @id @default(cuid())
  rdoId                String
  rdo                  Rdo             @relation(fields: [rdoId], references: [id])
  funcaoId             String
  funcao               FuncaoCatalogo  @relation(fields: [funcaoId], references: [id])
  colaboradorId        String?
  colaborador          Colaborador?    @relation(fields: [colaboradorId], references: [id])
  quantidade           Int             @default(1)
  horasImprodutivas    Decimal?        @db.Decimal(6, 2)
  causaImprodutividade String?
}

model RdoEquipamento {
  id                    String              @id @default(cuid())
  rdoId                 String
  rdo                   Rdo                 @relation(fields: [rdoId], references: [id])
  equipamentoCatalogoId String
  equipamentoCatalogo   EquipamentoCatalogo @relation(fields: [equipamentoCatalogoId], references: [id])
  quantidade            Int                 @default(1)
}

// Catálogo oficial de materiais/serviços com preço unitário (Price List do
// contrato — packages/server/prisma/data/materialCatalogo.json). Vinculado
// ao Contrato porque preços mudam de um contrato para o outro.
model MaterialCatalogo {
  id             String        @id @default(cuid())
  contratoId     String
  contrato       Contrato      @relation(fields: [contratoId], references: [id])
  codigo         String
  descricao      String
  unidade        String
  precoUnitario  Decimal?      @db.Decimal(14, 4)
  ativo          Boolean       @default(true)
  rdoMateriais   RdoMaterial[]

  @@unique([contratoId, codigo])
}

// Materiais consumidos no dia, escolhidos do catálogo (MaterialCatalogo).
model RdoMaterial {
  id                 String           @id @default(cuid())
  rdoId              String
  rdo                Rdo              @relation(fields: [rdoId], references: [id])
  materialCatalogoId String
  materialCatalogo   MaterialCatalogo @relation(fields: [materialCatalogoId], references: [id])
  quantidade         Decimal          @db.Decimal(12, 3)
  ordem              Int              @default(0)
}

model RdoAnexo {
  id             String    @id @default(cuid())
  rdoId          String
  rdo            Rdo       @relation(fields: [rdoId], references: [id])
  tipo           TipoAnexo
  caminhoArquivo String
  nomeOriginal   String
  mimeType       String
  tamanhoBytes   Int
  descricao      String?
  valor          Decimal?  @db.Decimal(12, 2)
  criadoEm       DateTime  @default(now())
}

model AprovacaoFiscal {
  id                    String          @id @default(cuid())
  rdoId                 String
  rdo                   Rdo             @relation(fields: [rdoId], references: [id])
  fiscalNome            String
  fiscalEmail           String
  token                 String          @unique
  tokenExpiraEm         DateTime
  status                AprovacaoStatus @default(PENDENTE)
  assinanteNome         String?
  assinadoEm            DateTime?
  assinadoIp            String?
  documentoHash         String?
  assinaturaImagemPath  String?
  comentarioReprovacao  String?         @db.Text
  criadoEm              DateTime        @default(now())
}

model RdoHistorico {
  id         String     @id @default(cuid())
  rdoId      String
  rdo        Rdo        @relation(fields: [rdoId], references: [id])
  deStatus   RdoStatus?
  paraStatus RdoStatus
  ator       String
  observacao String?    @db.Text
  criadoEm   DateTime   @default(now())
}

model PeriodoMedicao {
  id        String                @id @default(cuid())
  frenteId  String
  ano       Int
  mes       Int
  status    PeriodoMedicaoStatus  @default(ABERTO)
  fechadoEm DateTime?
  itens     MedicaoItem[]

  @@unique([frenteId, ano, mes])
}

model MedicaoItem {
  id                  String         @id @default(cuid())
  periodoMedicaoId    String
  periodoMedicao      PeriodoMedicao @relation(fields: [periodoMedicaoId], references: [id])
  atividadeCatalogoId String
  quantidadeTotal     Decimal        @db.Decimal(14, 3)
  unidade             UnidadeMedida

  @@unique([periodoMedicaoId, atividadeCatalogoId])
}
