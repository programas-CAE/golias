{
  "name": "@golias/desktop",
  "version": "0.4.2",
  "private": true,
  "description": "GOLIAS Desktop — aplicativo Electron para uso no escritório",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"vite\" \"pnpm run dev:electron\"",
    "dev:electron": "tsc -p tsconfig.node.json && wait-on tcp:5174 && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .",
    "build:renderer": "tsc -p tsconfig.json && vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "dist": "pnpm run build && electron-builder --win",
    "release": "pnpm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  }
}
