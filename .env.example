# Copie este arquivo para .env e ajuste os valores conforme o ambiente.
# Este .env.example é o de referência geral do monorepo; o pacote
# packages/server possui o seu próprio .env.example com as variáveis
# específicas da API.

# Banco de dados (docker-compose.yml sobe um Postgres local com estes valores)
POSTGRES_DB=golias
POSTGRES_USER=golias
POSTGRES_PASSWORD=golias
POSTGRES_PORT=5432

# Porta HTTP da API Fastify, e porta onde o Nginx interno do container "web"
# fica escutando no host — ambas só em 127.0.0.1 (ver docker-compose.yml),
# o reverse proxy do VPS (Nginx/Traefik/Caddy) é quem aponta pra elas.
SERVER_PORT=3333
WEB_PORT=8080

# URL pública da API, embutida no bundle do @golias/web em tempo de build
# (docker-compose.yml usa como build arg do serviço "web"). Deve ser a MESMA
# URL configurada em PUBLIC_API_URL no packages/server/.env — ex.:
# https://api.golias.engecomengenharia.online
VITE_API_URL=http://localhost:3333
