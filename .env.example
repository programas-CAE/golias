# Copie este arquivo para .env e ajuste os valores conforme o ambiente.
# Este .env.example é o de referência geral do monorepo; o pacote
# packages/server possui o seu próprio .env.example com as variáveis
# específicas da API.

# Banco de dados (docker-compose.yml sobe um Postgres local com estes valores)
POSTGRES_DB=golias
POSTGRES_USER=golias
POSTGRES_PASSWORD=golias
POSTGRES_PORT=5432
